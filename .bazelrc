# TODO(davido): On Bazel 10.x the --experimental_use_compact_object_headers
# startup option is on by default; drop this manual host_jvm_args then.
startup --host_jvm_args=-XX:+UseCompactObjectHeaders

common --lockfile_mode=error
# Reject transitive upgrades that change the requested direct module versions.
common --check_direct_dependencies=error
# Enable Gerrit-tree-only plugin checks (standalone plugin builds skip them).
common --@com_googlesource_gerrit_bazlets//flags:in_gerrit_tree=true
common --incompatible_disallow_struct_provider_syntax=false
common --incompatible_disallow_empty_glob=false
# Use explicit __init__.py files for Gerrit's Python targets and Bazel's
# @bazel_tools//tools/jdk:proguard_allowlister. This is the upcoming default, see
# https://github.com/bazel-contrib/rules_python/issues/2945.
common --@rules_python//python/config_settings:incompatible_default_to_explicit_init_py=true
common --@aspect_rules_ts//ts:default_to_tsc_transpiler
common --repo_env=ASPECT_TOOLS_TELEMETRY=-all

build --workspace_status_command="python3 ./tools/workspace_status.py"
common --repository_cache=~/.gerritcodereview/bazel-cache/repository
common --disk_cache=~/.gerritcodereview/bazel-cache/cas

# Builds using remotejdk_25, executes using remotejdk_25 or local_jdk
common --java_language_version=25
common --java_runtime_version=remotejdk_25
common --tool_java_language_version=25
common --tool_java_runtime_version=remotejdk_25

# Enables builds and execution on RBE
common:remote --config=config_gcp

# Define remote_gcp configuration alias
common:remote_gcp --config=remote

# Enables builds and execution on BuildBuddy RBE
common:remote_bb --config=config_bb

# Builds using remotejdk_21, executes using remotejdk_21 or local_jdk
common:build_java21_shared --java_language_version=21
common:build_java21_shared --java_runtime_version=remotejdk_21
common:build_java21_shared --tool_java_language_version=21
common:build_java21_shared --tool_java_runtime_version=remotejdk_21

common:java21 --config=build_java21_shared

# Builds and executes on RBE using remotejdk_21
common:remote21 --config=remote
common:remote21 --config=build_java21_shared

# Define remote21 configuration alias
common:remote21_gcp --config=remote21

# Builds and executes on BuildBuddy RBE using remotejdk_21
common:remote21_bb --config=remote_bb
common:remote21_bb --config=build_java21_shared

# Builds using remotejdk_25, executes using remotejdk_25 or local_jdk
common:build_java25_shared --java_language_version=25
common:build_java25_shared --java_runtime_version=remotejdk_25
common:build_java25_shared --tool_java_language_version=25
common:build_java25_shared --tool_java_runtime_version=remotejdk_25

common:java25 --config=build_java25_shared

# Builds and executes on RBE using remotejdk_25
common:remote25 --config=remote
common:remote25 --config=build_java25_shared

# Define remote25 configuration alias
common:remote25_gcp --config=remote25

# Builds and executes on BuildBuddy RBE using remotejdk_25
common:remote25_bb --config=remote_bb
common:remote25_bb --config=build_java25_shared

common --announce_rc

# TODO(davido): Remove after upgrade to JDK 27 (on by default).
test --jvmopt=-XX:+UseCompactObjectHeaders
test --build_tests_only
test --test_output=errors

import %workspace%/tools/remote-bazelrc

# User-specific .bazelrc
try-import %workspace%/user.bazelrc
