      "writtenOn": "2026-08-25T20:20:12Z",
      "side": 1,
      "message": "If `indexConfig.maxTerms()` is configured to 1 (the minimum allowed by `IndexConfig` validation), `batchSize` will be 0. This will cause `Iterables.partition(..., 0)` to throw an `IllegalArgumentException`.\n\nConsider using `Math.max(1, indexConfig.maxTerms() - 1)` to prevent this edge case.",
      "range": {
        "startLine": 67,
        "startChar": 0,
        "endLine": 67,
        "endChar": 0
      },
      "revId": "05a1f006da4c08ac0a3ba11e56b5bdc0277e98b4",
