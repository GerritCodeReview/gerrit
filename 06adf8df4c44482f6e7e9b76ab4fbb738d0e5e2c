      },
      "lineNbr": 133,
      "author": {
        "id": 1072905
      },
      "writtenOn": "2026-06-11T11:26:44Z",
      "side": 1,
      "message": "We are parsing each CIDR for every request.\n\nAn invalid configuration should cause Gerrit to fail startup with a clear error rather than discovering invalid values while serving traffic repeatedly constructing failing SubnetUtils instances.\n\nWDYT?",
      "range": {
        "startLine": 133,
        "startChar": 17,
        "endLine": 133,
        "endChar": 44
      },
      "revId": "06adf8df4c44482f6e7e9b76ab4fbb738d0e5e2c",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
    {
      "unresolved": false,
