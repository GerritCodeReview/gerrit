        "id": 1002666
      },
      "writtenOn": "2026-10-14T23:42:37Z",
      "side": 1,
      "message": "Can we widen this to \"without express permission from the maintainers/ESC\" and use the existing automated jobs as an example?",
      "range": {
        "startLine": 139,
        "startChar": 10,
        "endLine": 141,
        "endChar": 69
      },
      "revId": "1ade253d3c4f72a64679b24c7c54c89280d54b3d",
