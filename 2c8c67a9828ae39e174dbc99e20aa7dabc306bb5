      "writtenOn": "2026-01-07T21:13:14Z",
      "side": 1,
      "message": "This sentence isn\u0027t a direct consequence of the previous one.\n\nThe fact that AI can provide a nice summary of the commit message, does not mean that AI can understand what\u0027s the impact for the Gerrit admin after the modifications of the code.\n\nWe would need to integrate with Gerrit MCP to have that context, which isn\u0027t in place at the moment.",
      "range": {
        "startLine": 10,
        "startChar": 27,
        "endLine": 11,
        "endChar": 42
      },
      "revId": "2c8c67a9828ae39e174dbc99e20aa7dabc306bb5",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "dcb9db6b_9b85988c",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 12,
