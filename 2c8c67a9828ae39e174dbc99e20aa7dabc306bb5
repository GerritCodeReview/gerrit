      },
      "writtenOn": "2025-12-17T13:29:19Z",
      "side": 1,
      "message": "Leaving the approval to Luca since he\u0027s taking care of most of the releases.",
      "revId": "2c8c67a9828ae39e174dbc99e20aa7dabc306bb5",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
