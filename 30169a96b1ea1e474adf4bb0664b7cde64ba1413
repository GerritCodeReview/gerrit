      "writtenOn": "2025-03-16T09:42:57Z",
      "side": 1,
      "message": "We tag our release commit, for example, tagging with \u0027v3.2.14-43-g13eabbd5f1\u0027, tells us that our release is based on Gerrit 3.2 and also the specific commit can be found easily.",
      "parentUuid": "6a78fb72_6eab0ecc",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 35
      },
      "revId": "30169a96b1ea1e474adf4bb0664b7cde64ba1413",
