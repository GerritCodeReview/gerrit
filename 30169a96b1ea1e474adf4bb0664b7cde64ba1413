      "author": {
        "id": 1142566
      },
      "writtenOn": "2025-03-17T10:11:28Z",
      "side": 1,
      "message": "because the release branch can move in the meantime, a patch release for example. Having a tag allows multipe marks per release branch.",
      "parentUuid": "2bf0fab1_9071d602",
      "range": {
        "startLine": 12,
        "startChar": 0,
        "endLine": 12,
        "endChar": 35
      },
      "revId": "30169a96b1ea1e474adf4bb0664b7cde64ba1413",
