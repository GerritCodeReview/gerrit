      "writtenOn": "2024-12-11T14:46:10Z",
      "side": 1,
      "message": "IIUC, there is a PluginCommitValidationListener, which executes all listeners from plugins. All messages from such listeners will be collected together and put under the name \"PluginCommitValidationListener\" (instead of a separate names for each validitor from plugins). Is it ok?",
      "range": {
        "startLine": 293,
        "startChar": 30,
        "endLine": 293,
        "endChar": 64
      },
      "revId": "3cc06c6def82cb22a07017d7f4378f7ee3140270",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
