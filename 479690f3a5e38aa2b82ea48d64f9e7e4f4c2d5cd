      "writtenOn": "2024-11-13T23:17:02Z",
      "side": 1,
      "message": "Some really rough pseudo code that might help achieve this (where \"parked\" is a collection that can handle concurrent adds and removes):\n\nparked.foreach(if (task.lock()) { if (...isReady()) { parked.remove(); task.unlock()})",
      "parentUuid": "ce046839_64b2874c",
      "revId": "479690f3a5e38aa2b82ea48d64f9e7e4f4c2d5cd",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
