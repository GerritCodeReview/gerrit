      "writtenOn": "2026-08-01T02:02:12Z",
      "side": 1,
      "message": "How does unmet_requirement (and similar fields below) behave in case of an error or timeout? Would, for example, unmet_requirement:foo match all changes if there is a timeout evaluating requirements?",
      "revId": "527652179a64b4cec32c6641cfa287de33f53a76",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
