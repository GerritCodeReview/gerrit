      "side": 1,
      "message": "This results in marking all of these commits as uninteresting, so we won\u0027t walk to them. Does removing the heads/tags mean we walk more commits?",
      "revId": "59f3e1ca5f9164af507f5d753a8f2d82c10c1c06",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
