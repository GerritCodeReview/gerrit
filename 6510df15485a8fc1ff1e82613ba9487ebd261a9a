        "id": 1011323
      },
      "writtenOn": "2026-05-31T12:06:25Z",
      "side": 1,
      "message": "Consider naming it `threadLocalRequestContextProvider` to avoid a potential clash with a future `Provider\u003cRequestContext\u003e requestContextProvider` injection.",
      "range": {
        "startLine": 59,
        "startChar": 42,
        "endLine": 59,
        "endChar": 64
      },
      "revId": "6510df15485a8fc1ff1e82613ba9487ebd261a9a",
