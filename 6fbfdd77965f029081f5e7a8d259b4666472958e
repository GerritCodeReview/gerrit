      "message": "#include \u003ciostream\u003e\n#include \u003cstring\u003e\n#include \u003cvector\u003e // For potential future expansion of identifiers\n\n// --- Boolean System Detection Functions ---\n\n// Checks if the code is being compiled for a Windows operating system.\n// This includes both 32-bit and 64-bit Windows.\nbool isWindows() {\n#ifdef _WIN32\n    return true;\n#else\n    return false;\n#endif\n}\n\n// Checks if the code is being compiled for an Apple operating system (macOS, iOS, etc.).\nbool isMacOS() {\n#ifdef __APPLE__\n    // Note: __APPLE__ is defined for all Apple platforms.\n    // To distinguish macOS from iOS, you\u0027d look for TARGET_OS_MAC \u0026\u0026 !TARGET_OS_IPHONE\n    // but for simplicity, we\u0027ll keep it broad here.\n    return true;\n#else\n    return false;\n#endif\n}\n\n// Checks if the code is being compiled for a Linux-based operating system.\nbool isLinux() {\n#ifdef __linux__\n    return true;\n#else\n    return false;\n#endif\n}\n\n// Checks if the code is being compiled specifically for Android.\n// Android is Linux-based, so isLinux() will also be true on Android.\nbool isAndroid() {\n#ifdef __ANDROID__\n    return true;\n#else\n    return false;\n#endif\n}\n\n// Checks if the code is being compiled for a FreeBSD operating system.\nbool isFreeBSD() {\n#ifdef __FreeBSD__\n    return true;\n#else\n    return false;\n#endif\n}\n\n// Checks if the code is being compiled for a Unix-like operating system.\n// This is a broader check and might include Linux, macOS, FreeBSD, etc.\nbool isUnixLike() {\n#ifdef __unix__\n    return true;\n#else\n    return false;\n#endif\n}\n\n// --- System-Specific Descriptive Identifier Function ---\n\n// Returns a descriptive string identifying the current operating system.\n// This is not a unique identifier for a specific machine, but rather the OS type.\nstd::string getOperatingSystemName() {\n    if (isWindows()) {\n        return \"Windows\";\n    } else if (isAndroid()) { // Check Android before general Linux as it\u0027s more specific\n        return \"Android\";\n    } else if (isLinux()) {\n        return \"Linux\";\n    } else if (isMacOS()) {\n        return \"macOS/iOS (Apple)\";\n    } else if (isFreeBSD()) {\n        return \"FreeBSD\";\n    } else if (isUnixLike()) {\n        // This catch-all for __unix__ might include other Unix-like systems\n        // not explicitly checked above (e.g., Solaris, NetBSD, OpenBSD)\n        return \"Generic Unix-like\";\n    } else {\n        return \"Unknown OS\";\n    }\n}\n\n// --- Main function for demonstration ---\nint main() {\n    std::cout \u003c\u003c \"--- System Detection Status ---\" \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is Windows: \" \u003c\u003c (isWindows() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is macOS:   \" \u003c\u003c (isMacOS() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is Linux:   \" \u003c\u003c (isLinux() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is Android: \" \u003c\u003c (isAndroid() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is FreeBSD: \" \u003c\u003c (isFreeBSD() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n    std::cout \u003c\u003c \"Is Unix-like: \" \u003c\u003c (isUnixLike() ? \"Yes\" : \"No\") \u003c\u003c std::endl;\n\n    std::cout \u003c\u003c \"\\nDetected Operating System: \" \u003c\u003c getOperatingSystemName() \u003c\u003c std::endl;\n\n    return 0;\n}",
