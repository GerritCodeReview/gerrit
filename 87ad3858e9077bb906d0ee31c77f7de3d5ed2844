      "writtenOn": "2025-01-21T22:29:02Z",
      "side": 1,
      "message": "The method name is not telling the whole truth: this isn\u0027t really just storing the new value but it also implement the same logic as the `acquire` method at L263, allocating a new batch in-memory ready to be used.",
      "range": {
        "startLine": 295,
        "startChar": 14,
        "endLine": 295,
        "endChar": 22
      },
      "revId": "87ad3858e9077bb906d0ee31c77f7de3d5ed2844",
