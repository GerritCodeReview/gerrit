      "writtenOn": "2025-11-20T09:52:48Z",
      "side": 1,
      "message": "We already did this when we had the tests, this approach caused a 20% increase compared to baseline while the other approach caused a ~5% increase.",
      "parentUuid": "ff7ed9a7_529d9e7b",
      "range": {
        "startLine": 91,
        "startChar": 10,
        "endLine": 91,
        "endChar": 35
