      "lineNbr": 258,
      "author": {
        "id": 1003935
      },
      "writtenOn": "2025-10-27T08:26:50Z",
      "side": 1,
      "message": "The caller provides a SHA1 in base.input but doesn\u0027t know if a change for this SHA1 exists (e.g. because the SHA1 was provided by the user and the calling code didn\u0027t check if a change for this SHA1 does exist).",
      "parentUuid": "32dee09e_784510e5",
      "range": {
