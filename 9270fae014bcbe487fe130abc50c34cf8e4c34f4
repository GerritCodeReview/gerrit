      "writtenOn": "2025-10-27T07:09:33Z",
      "side": 1,
      "message": "what does a change being unknown mean in this context?",
      "range": {
        "startLine": 258,
        "startChar": 51,
        "endLine": 258,
        "endChar": 62
      },
      "revId": "9270fae014bcbe487fe130abc50c34cf8e4c34f4",
