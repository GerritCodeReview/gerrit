        "id": 1003935
      },
      "writtenOn": "2025-10-27T08:26:50Z",
      "side": 1,
      "message": "Yes, input.base is a commit SHA1. Any commit that is present in a branch is allowed as the base. This can be a commit that was pushed directly, or a merge commit that was created via the Merge If Necessary submit strategy on submit. In these cases the commit cannot be resolved to a change via the change index.\n\nAlso see the description of the base field here:\nhttps://gerrit-review.googlesource.com/Documentation/rest-api-changes.html#cherrypick-input",
      "parentUuid": "b2950446_cd3bed37",
      "range": {
        "startLine": 257,
        "startChar": 69,
        "endLine": 257,
        "endChar": 91
      },
      "revId": "9270fae014bcbe487fe130abc50c34cf8e4c34f4",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
