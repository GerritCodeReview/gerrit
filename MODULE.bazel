module(name = "gerrit")

# Core Bazel deps.
bazel_dep(name = "bazel_features", version = "1.51.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# Language rules.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_rollup", version = "2.0.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_android", version = "0.8.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "java_tools", version = "23.0-davido.1")
bazel_dep(name = "jdk_catalog", version = "0.0.2-catalog.1")
bazel_dep(name = "rules_nodejs", version = "6.7.6")
bazel_dep(name = "rules_python", version = "2.4.5")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Pin the Bzlmod catalog-split prototype to reproducible GitHub commits.
# These source overrides replace registry resolution for all three modules.
git_override(
    module_name = "rules_java",
    commit = "a5701dd179685c5373314736e69eef4b48ba2c37",
    remote = "https://github.com/davido/rules_java.git",
)

git_override(
    module_name = "java_tools",
    commit = "34d71142ce6b94f4434ea42d5fdaeba699e386b8",
    remote = "https://github.com/davido/java_tools.git",
)

git_override(
    module_name = "jdk_catalog",
    commit = "002ecea3317579078b8b878ff11260e604886c43",
    remote = "https://github.com/davido/jdk_catalog.git",
)

# Libraries / toolchains.
bazel_dep(name = "protobuf", version = "36.2")

# TODO(davido): Gerrit uses Java protobufs only. Disable Protobuf's transitive
# Rust setup until upstream avoids resolving Cargo/Rust tools for non-Rust consumers.
# https://github.com/protocolbuffers/protobuf/issues/30684
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//tools/patches:protobuf-36.2-no-rust.patch"],
    version = "36.2",
)

# Toolchain setup.
register_toolchains("//tools:all")

# JDK 27 toolchains are published by jdk_catalog. Under
# --incompatible_restrict_non_root_registrations (bazel #32428) a non-root
# module's registrations for rules_java's toolchain types are ignored, so the
# root registers them here. jdk_catalog hosts compile, runtime and bootstrap
# toolchains in one package, so a single target covers all of them.
register_toolchains("@jdk_catalog//toolchains:all")

# Plugin packaging support: bazlets pin and generated Gerrit API version repo.
include("//tools:bazlets.MODULE.bazel")

# Repository rules for in-tree sources.
include("//tools:repos.MODULE.bazel")

# External dependency wiring is split out.
include("//tools:java_deps.MODULE.bazel")

# PolyGerrit dependency wiring is split out.
include("//polygerrit-ui:polygerrit.MODULE.bazel")

# Wiring for external dependencies contributed by in-tree plugins.
include("//plugins:external_plugin_deps.MODULE.bazel")
