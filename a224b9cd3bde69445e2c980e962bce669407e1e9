    {
      "unresolved": false,
      "key": {
        "uuid": "20b2ea1b_3bd87b96",
        "filename": "java/com/google/gerrit/server/project/CreateRefControl.java",
        "patchSetId": 1
      },
      "lineNbr": 149,
