      "writtenOn": "2020-10-21T12:37:52Z",
      "side": 1,
      "message": "Why is this check relevant?\n\nif currentUserAccountId was null, wouldn\u0027t hasAccessDatabase and accountId.equals(currentUserAccountId) both be false and hence we would have returned false?",
      "parentUuid": "049948ce_4da1bace",
      "range": {
        "startLine": 114,
