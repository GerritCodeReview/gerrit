      },
      "lineNbr": 114,
      "author": {
        "id": 1003935
      },
      "writtenOn": "2020-10-21T16:20:57Z",
      "side": 1,
      "message": "So with the new logic in hasReadPermissionOnRef this would trigger an ISE for anonymous now? Shouldn\u0027t it rather filter out the ref than fail?",
      "parentUuid": "442cf10b_572b195c",
      "range": {
        "startLine": 114,
        "startChar": 58,
        "endLine": 114,
        "endChar": 89
      },
      "revId": "a2687dd873dff0582dfbea957890810fd53ce21e",
