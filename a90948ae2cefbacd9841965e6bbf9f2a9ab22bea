    },
    {
      "unresolved": false,
      "key": {
        "uuid": "011b9dae_2d1efbb6",
        "filename": "java/com/google/gerrit/util/concurrent/ConcurrentBloomFilter.java",
        "patchSetId": 3
      },
      "lineNbr": 81,
