      "writtenOn": "2026-10-14T07:16:47Z",
      "side": 1,
      "message": "issue: AFAIU this line is broken, any link ending here would be prefixed with `http` which means that for any site that is hosted behind the `https` and not rewritten by proxy that would lead to wrong address... How about minting link to settings so that it would be the fully qualified link?",
      "range": {
        "startLine": 199,
        "startChar": 4,
        "endLine": 199,
        "endChar": 66
      },
      "revId": "b2b051a22958ddab9e920faf8e93642095ce16d6",
