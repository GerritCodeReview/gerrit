      "writtenOn": "2026-10-13T16:04:21Z",
      "side": 1,
      "message": "Why not export the list of supported formats instead of being specific to RefTable?",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 67
      },
      "revId": "d483e177f8340ef0555c7d0f5ce154b623b7ec3f",
