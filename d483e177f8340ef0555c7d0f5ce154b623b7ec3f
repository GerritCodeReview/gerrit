    },
    {
      "unresolved": false,
      "key": {
        "uuid": "4f64d9d7_0bb1359c",
        "filename": "/COMMIT_MSG",
        "patchSetId": 2
      },
      "lineNbr": 7,
      "author": {
        "id": 1011323
      },
      "writtenOn": "2026-10-19T12:48:38Z",
      "side": 1,
      "message": "REF_DIRECTORY is always available and can\u0027t be disabled, so a list would always contain it and only conditionally add REFTABLE — the REF_DIRECTORY entry carries no information.\n\nServerInfo already follows this principle: it doesn\u0027t advertise the supported VCS, because Git is the only one.\n\nThe single flag signals the one case that is actually conditional. It\u0027s also transient — it exists only because reftable currently can\u0027t be used together with core.usePerRequestRefCache; once that restriction is lifted, the flag and the precondition go away, so a general supported-formats list would outlive its purpose (YAGNI principle).",
      "parentUuid": "633fecad_fdbb65fe",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 67
      },
      "revId": "d483e177f8340ef0555c7d0f5ce154b623b7ec3f",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
