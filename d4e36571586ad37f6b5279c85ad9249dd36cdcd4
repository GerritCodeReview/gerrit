      },
      "lineNbr": 3203,
      "author": {
        "id": 1003935
      },
      "writtenOn": "2025-08-01T13:25:42Z",
      "side": 1,
      "message": "It depends what\u0027s the intention of the integration. If it wants to enforce a label for everyone, overriding the label should not be allowed. If it wants to add an optional default label, it can be overridable.\n\nIn the case that we have in mind, it will not be overridable.\n\nThis is no different from defining a label in All-Projects. When adding the label definition there you also need to decide if it should be overridable or not.",
      "parentUuid": "5558961e_776a1f79",
      "range": {
        "startLine": 3201,
        "startChar": 60,
        "endLine": 3203,
        "endChar": 14
      },
      "revId": "d4e36571586ad37f6b5279c85ad9249dd36cdcd4",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
