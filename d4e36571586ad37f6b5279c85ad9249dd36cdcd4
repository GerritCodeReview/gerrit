        "id": 1083225
      },
      "writtenOn": "2025-08-01T12:54:03Z",
      "side": 1,
      "message": "how is this binding making it global?\n\nIs it because it\u0027s inside `BatchProgramModule`?",
      "range": {
        "startLine": 228,
        "startChar": 4,
        "endLine": 229,
        "endChar": 56
      },
      "revId": "d4e36571586ad37f6b5279c85ad9249dd36cdcd4",
