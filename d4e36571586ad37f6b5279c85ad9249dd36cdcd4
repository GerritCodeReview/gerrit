    },
    {
      "unresolved": false,
      "key": {
        "uuid": "69d6b236_8251a008",
        "filename": "java/com/google/gerrit/pgm/util/BatchProgramModule.java",
        "patchSetId": 2
      },
      "lineNbr": 229,
      "author": {
        "id": 1003935
      },
      "writtenOn": "2025-08-01T13:25:42Z",
      "side": 1,
      "message": "This binding doesn\u0027t make anything global.\n\nThe code that makes labels global is in ProjectState, where we get the LabelType extensions injected. There we add them to the labels list before adding labels from the project hierarchy (i.e. before adding labels that are defined in All-Projects).\n\nThe BatchProgramModule defines the Guice stack for the Gerrit standalone programs [1]. So this makes the implementations that are bound to the LabelType/SubmitRequirement extension points available when running these standalone programs.\n\n[1] https://gerrit-review.googlesource.com/Documentation/pgm-index.html",
      "parentUuid": "262d719d_4a091c65",
      "range": {
        "startLine": 228,
        "startChar": 4,
        "endLine": 229,
        "endChar": 56
      },
      "revId": "d4e36571586ad37f6b5279c85ad9249dd36cdcd4",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
