      "writtenOn": "2026-10-05T08:40:08Z",
      "side": 1,
      "message": "HttpConfiguration applies customizers in registration order. ForwardedRequestCustomizer sets the remote address from\n X-Forwarded-For; then ProxyCustomizer overwrites it with data from the PROXY protocol EndPoint attributes. This means\n PROXY protocol data takes precedence, directly contradicting the documentation:\n\n \u003e \"If both a PROXY protocol header and X-Forwarded-For are present, the X-Forwarded-For header takes precedence for the\n  client address.\"",
      "range": {
        "startLine": 437,
        "startChar": 0,
        "endLine": 439,
        "endChar": 9
      },
      "revId": "d5e6aec46c8c3f9b2d216814d61f4198f5a5895f",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
