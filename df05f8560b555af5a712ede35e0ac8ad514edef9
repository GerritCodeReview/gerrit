      "side": 1,
      "message": "How does it destroy the parsed state ?\nCan we fix #areAllReachable to not destroy this state ?",
      "revId": "df05f8560b555af5a712ede35e0ac8ad514edef9",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
