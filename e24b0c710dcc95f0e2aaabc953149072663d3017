      "writtenOn": "2026-10-29T08:03:04Z",
      "side": 1,
      "message": "We are bypassing the `core.usePerRequestRefCache` check. We might endup with a `REFTABLE`repo with  `core.usePerRequestRefCache`set.",
      "revId": "e24b0c710dcc95f0e2aaabc953149072663d3017",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
