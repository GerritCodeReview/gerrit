      "lineNbr": 75,
      "author": {
        "id": 1011323
      },
      "writtenOn": "2026-10-29T13:40:56Z",
      "side": 1,
      "message": "JGit renames the old storage to `.old` with REPLACE_EXISTING, so an existing backup is overwritten. Only a non-empty target-format dir fails (409). Same behavior as the convert-ref-storage SSH command.",
      "parentUuid": "a062fa6a_4f1772e7",
      "revId": "e24b0c710dcc95f0e2aaabc953149072663d3017",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
    },
