      "writtenOn": "2025-05-15T12:53:02Z",
      "side": 1,
      "message": "Why do we have two different `AuthToken` loading implementations: one here and one in the `DirectAuthTokenAccessor`? Why is this cache loader not delegating loading to the `DirectAuthTokenAccessor`?",
      "range": {
        "startLine": 91,
        "startChar": 0,
        "endLine": 108,
        "endChar": 7
      },
      "revId": "e924d7f8e72bd2810c8bbcbc80e6cdaea1353bbb",
