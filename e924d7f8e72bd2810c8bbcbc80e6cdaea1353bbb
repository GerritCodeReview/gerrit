      "lineNbr": 108,
      "author": {
        "id": 1065256
      },
      "writtenOn": "2025-05-16T10:09:47Z",
      "side": 1,
      "message": "Done\nHowever thinking about it again: This again adds HTTP passwords to the token cache and I would again have to evict it from other places, which we tried to avoid.",
      "parentUuid": "7ae6750b_4f07168c",
      "range": {
        "startLine": 91,
        "startChar": 0,
        "endLine": 108,
        "endChar": 7
      },
      "revId": "e924d7f8e72bd2810c8bbcbc80e6cdaea1353bbb",
