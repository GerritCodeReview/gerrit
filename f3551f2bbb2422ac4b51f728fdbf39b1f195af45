    {
      "key": {
        "uuid": "20117004_3fc7eead",
        "filename": "Documentation/rest-api-verifiers.txt",
        "patchSetId": 11
      },
      "lineNbr": 111,
      "author": {
        "id": 1010008
      },
      "writtenOn": "2019-02-04T12:21:26Z",
      "side": 1,
      "message": "I feel like at some point in this doc we should describe the purpose and format of the UUID. It\u0027s implied that this is not user-controlled, because it\u0027s not a field in VerifierInput. But I think it\u0027s worth being explicit about the fact that the UUID is immutable, generated by Gerrit, etc.",
      "revId": "f3551f2bbb2422ac4b51f728fdbf39b1f195af45",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "87f25b2e_26ba1dc5",
        "filename": "Documentation/rest-api-verifiers.txt",
        "patchSetId": 11
      },
      "lineNbr": 111,
      "author": {
        "id": 1003935
      },
      "writtenOn": "2019-02-05T14:23:40Z",
      "side": 1,
      "message": "Mostly done.\n\nThe format is not further described because caller shouldn\u0027t make any assumptions about it.",
      "parentUuid": "20117004_3fc7eead",
      "revId": "f3551f2bbb2422ac4b51f728fdbf39b1f195af45",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153",
      "unresolved": false
