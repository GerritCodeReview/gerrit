      "writtenOn": "2024-12-21T19:46:36Z",
      "side": 1,
      "message": "Sounds reasonable, will try to do so.",
      "parentUuid": "ac046fe8_fb1b6246",
      "revId": "f625a8adf4979c20bf2e1e80b5e11df421842f1d",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
