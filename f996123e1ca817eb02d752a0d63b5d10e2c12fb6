        "id": 1002666
      },
      "writtenOn": "2026-05-15T17:58:09Z",
      "side": 1,
      "message": "Should it be? Seems like someone could do `age:1minute` if they really wanted a very minimal age criteria.",
      "parentUuid": "0201158e_47426f23",
      "revId": "f996123e1ca817eb02d752a0d63b5d10e2c12fb6",
      "serverId": "173816e5-2b9a-37c3-8a2e-48639d4f1153"
