def _generate_node_modules_licenses_map(ctx):
    #for f in ctx.attr.node_modules.files.to_list():
    #    print(f)
    #print(ctx.files._tool)
    #ctx.runfiles(files = ctx.files._tools, transitive_files = ctx.attr._node)
    args = ctx.actions.args()
    args.add_all(ctx.files.node_modules)
    args.use_param_file("%s", use_always = True)
    print(ctx.files.licenses)

    ctx.actions.run(
        executable = ctx.executable._license_tool,
        arguments = [ctx.file.packages_licenses.path, args, ctx.outputs.json.path],
        #arguments = ["test_tool.js"],
        outputs = [ctx.outputs.json],
        #        tools = ctx.files._tools,
        inputs = depset([ctx.file.packages_licenses], transitive = [ctx.attr.node_modules.files, depset(ctx.files.licenses)]),
    )

generate_node_modules_licenses_map = rule(
    implementation = _generate_node_modules_licenses_map,
    attrs = {
        "packages_licenses": attr.label(allow_single_file = True),
        "node_modules": attr.label(),
        "licenses": attr.label_list(allow_files = True, mandatory = True),
        "_license_tool": attr.label(
            default = Label("//tools/node_tools:license-tool"),
            executable = True,
            cfg = "host",
        ),
    },
    outputs = {
        "json": "%{name}.json",
    },
)

