def _attach_license_impl(ctx):
    files = []
    for src in ctx.attr.srcs:
        for f in src.files.to_list():
            print(ctx.attr.license, f.owner.name)
            file = ctx.actions.declare_file(f.owner.name)
            files.append(file)
            ctx.actions.write(file, "")
    return [DefaultInfo(files = depset(files))]

attach_license = rule(
    implementation = _attach_license_impl,
    attrs = {
        "license": attr.label(),
        "srcs": attr.label_list(),
    },
)

NodeModuleLicenseInfo = provider(fields = ["package", "license", "license_type", "package_license_file"])

def _node_module_license_impl(ctx):
    if ctx.attr.license and (ctx.attr.license_type or ctx.attr.package_license_file):
        fail("'license' attribute can't be used together with 'license_type' or 'package_license_file' attribute")

    if ctx.attr.package_license_file and not ctx.attr.license_type:
        fail("'package_license_file' can't be used without 'license_type'")

    if ctx.attr.license:
        return NodeModuleLicenseInfo(package = ctx.attr.package, license = ctx.attr.license)
    return NodeModuleLicenseInfo(package = ctx.attr.package, license_type = ctx.attr.license_type, package_license_file = ctx.attr.package_license_file)

node_module_license = rule(
    implementation = _node_module_license_impl,
    attrs = {
        "package": attr.string(mandatory = True),
        "license": attr.label(),
        "license_type": attr.label(),
        "package_license_file": attr.string(),
    },
)

