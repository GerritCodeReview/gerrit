load("//polygerrit-ui/app/node_modules_licenses:licenses.bzl", "define_license_type")

def define_licenses_types():
    #Allowed licenses
    define_license_type(name = "MIT", allow_distribute = True)
    define_license_type(name = "BSD-3-Clause", allow_distribute = True)

    #Not allowed licenses
    define_license_type(name = "DO-NOT-DISTRIBUTE-LGPLv3", allow_distribute = False)

    #Special license types. Use it if you want to be sure that file/package doesn't include in the release
    define_license_type(name = "DO-NOT-DISTRIBUTE-MIT", allow_distribute = False)
    define_license_type(name = "DO-NOT-DISTRIBUTE-BSD-3", allow_distribute = False)
