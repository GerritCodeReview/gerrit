{namespace com.google.gerrit.server.mail.template.SshKeyExpired}

/**
 * The .SshKeyExpired template will determine the contents of the email related to
 * an SSH key being expired.
 */
{template SshKeyExpired kind="text"}
  {@param email: ?}
  The SSH key "{$email.keyName}" on Gerrit Code Review at
  {sp}{$email.gerritHost} has expired at {$email.expirationDate}.

  {\n}
  {\n}

  The SSH key is
  {\n}
  {$email.sshPublicKey}

  {\n}
  {\n}

  To add a new SSH key visit
  {\n}
  {$email.sshKeysSettingsUrl}.
  {\n}

  {\n}
  {\n}

  If clicking the link above does not work, copy and paste the URL in a new
  browser window instead.

  {\n}
  {\n}

  This is a send-only email address.  Replies to this message will not be read
  or answered.
{/template}
