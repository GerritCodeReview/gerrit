{namespace com.google.gerrit.server.mail.template.SshKeyWillExpireHtml}

{template SshKeyWillExpireHtml}
  {@param email: ?}
  <p>
    The SSH key "{$email.keyName}" on Gerrit Code Review at{sp}
    {$email.gerritHost} will expire on {$email.expirationDate}.
  </p>

  <p>
    The SSH key is
  </p>

  <pre style="white-space: pre-wrap; word-break: break-all;">{$email.sshPublicKey}</pre>

  <p>
    To add a new SSH key visit{sp}
    <a href="{$email.sshKeysSettingsUrl}">this link</a>.
  </p>

  <p>
    This is a send-only email address.  Replies to this message will not be read
    or answered.
  </p>
{/template}
