<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="ERROR">

  <!-- Console appender -->
  <Appenders>
    <Console name="StdErr" target="SYSTEM_ERR">
      <PatternLayout pattern="[%d] [%t] %-5p %c %x: %m%n"/>
    </Console>
  </Appenders>

  <!-- Root logger -->
  <Loggers>
    <Root level="INFO">
      <AppenderRef ref="StdErr"/>
    </Root>

    <!-- Silence non-critical messages from MINA SSHD -->
    <Logger name="org.apache.mina" level="WARN" additivity="false"/>
    <Logger name="org.apache.sshd.client" level="WARN" additivity="false"/>
    <Logger name="org.apache.sshd.common" level="WARN" additivity="false"/>
    <Logger name="org.apache.sshd.server" level="WARN" additivity="false"/>
    <Logger name="org.apache.sshd.common.keyprovider.FileKeyPairProvider" level="INFO" additivity="false"/>
    <Logger name="com.google.gerrit.sshd.GerritServerSession" level="WARN" additivity="false"/>

    <!-- Silence non-critical messages from mime-util -->
    <Logger name="eu.medsea.mimeutil" level="WARN" additivity="false"/>

    <!-- Silence non-critical messages from openid4java -->
    <Logger name="org.apache.http" level="WARN" additivity="false"/>
    <Logger name="org.apache.xml" level="WARN" additivity="false"/>
    <Logger name="org.openid4java" level="WARN" additivity="false"/>
    <Logger name="org.openid4java.consumer.ConsumerManager" level="FATAL" additivity="false"/>
    <Logger name="org.openid4java.discovery.Discovery" level="ERROR" additivity="false"/>
    <Logger name="org.openid4java.server.RealmVerifier" level="ERROR" additivity="false"/>
    <Logger name="org.openid4java.message.AuthSuccess" level="ERROR" additivity="false"/>
  </Loggers>
</Configuration>
