{
  "compilerOptions": {
    "target": "es2021",
    "module": "es2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "tools/node_tools/utils/*": ["../utils/*"]
    }
  },
  "include": ["*.ts", "*.d.ts"]
}
