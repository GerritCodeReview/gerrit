# Hermetic C++ toolchain for remote execution. The executor is linux-x86_64
# (//tools/remote:platform), which may differ from the machine running Bazel,
# so the toolchain is selected through --extra_toolchains in the remote
# configs (see tools/remote-bazelrc) rather than register_toolchains(), which
# would also change local builds.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

llvm.toolchain(
    # Generate the toolchain for the executor, not for the machine that runs
    # Bazel (e.g. macOS).
    exec_arch = "x86_64",
    exec_os = "linux",
    llvm_version = "20.1.8",
)

use_repo(llvm, "llvm_toolchain")

# The Node.js binary from nodejs.org needs libatomic.so.1, which the remote
# executor image lacks. //tools/remote/nodejs:nodejs_toolchain bundles it with node and
# is only selected by the rbe config (see tools/meroton-bazelrc).
libatomic = use_repo_rule("//tools/remote/nodejs:libatomic.bzl", "libatomic")

libatomic(
    name = "libatomic_ubuntu_24_04",
    sha256 = "fe49cbbc7be753528380c724a8eef5f1e31dffa9221f692c5069048d81c7449d",
    urls = ["https://archive.ubuntu.com/ubuntu/pool/main/g/gcc-14/libatomic1_14.2.0-4ubuntu2~24.04.1_amd64.deb"],
)

rbe_node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")

use_repo(rbe_node, "nodejs_linux_amd64")
